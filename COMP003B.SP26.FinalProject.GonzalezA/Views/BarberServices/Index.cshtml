@model IEnumerable<COMP003B.SP26.FinalProject.GonzalezA.Models.BarberService>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
@foreach (var item in Model)
{
    <partial name="_ServiceCard" model-"item" />
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ServiceName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstimatedMinutes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ServiceName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstimatedMinutes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.BarberServiceId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.BarberServiceId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.BarberServiceId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
